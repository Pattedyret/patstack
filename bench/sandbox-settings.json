{
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyRead": [
        "~"
      ]
    },
    "network": {
      "allowedDomains": []
    }
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "deny": [
      "WebFetch",
      "WebSearch",
      "Read(~/**)",
      "Edit(~/**)",
      "Write(~/**)"
    ],
    "allow": [
      "Bash"
    ]
  }
}
